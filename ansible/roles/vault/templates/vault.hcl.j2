storage "file" {
  path = "/opt/vault/data"
}

listener "tcp" {
  address     = "0.0.0.0:8200"
  tls_disable = 1
}

# GCP: Shamir seal (unseal manual).
# Si deseas auto-unseal, configura seal "gcpckms" con tu KMS de Google Cloud.

ui = true
disable_mlock = true

api_addr = "http://{{ ansible_host }}:8200"
